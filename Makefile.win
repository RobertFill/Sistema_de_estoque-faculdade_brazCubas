# Project: tarefa-3
# Makefile created by Dev-C++ 5.0.0.5

CPP      = g++.exe
CC       = gcc.exe
WINDRES  = windres.exe
RES      = 
OBJ      = main.o produto.o uitl.o categoria.o $(RES)
LINKOBJ  = main.o produto.o uitl.o categoria.o $(RES)
LIBS     = -L"D:/programs/Dev-Cpp/lib" -L"D:/programs/Dev-Cpp/lib/gcc" -static-libstdc++ -static-libgcc  
INCS     = -I"D:/programs/Dev-Cpp/include" 
CXXINCS  = -I"D:/programs/Dev-Cpp/include" 
BIN      = Sistema_Estoque.exe
CXXFLAGS = $(CXXINCS)  
CFLAGS   = $(INCS)  
RM       = rm -f

.PHONY: all all-before all-after clean clean-custom

all: all-before Sistema_Estoque.exe all-after


clean: clean-custom
	${RM} $(OBJ) $(BIN)

$(BIN): $(OBJ)
	$(CC) $(LINKOBJ) -o "Sistema_Estoque.exe" $(LIBS)

main.o: main.c
	$(CC) -c main.c -o main.o $(CFLAGS)

produto.o: produto.c
	$(CC) -c produto.c -o produto.o $(CFLAGS)

uitl.o: uitl.c
	$(CC) -c uitl.c -o uitl.o $(CFLAGS)

categoria.o: categoria.c
	$(CC) -c categoria.c -o categoria.o $(CFLAGS)
